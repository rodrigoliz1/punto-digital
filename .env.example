# =============================================================
# PUNTO DIGITAL — Variables de entorno
# =============================================================
# Copia este archivo como .env.local para desarrollo local
# y configura estas variables en Vercel para producción.
# =============================================================

# --- OBLIGATORIAS (sin ellas la app no funciona) ---

# URL pública del sitio en producción
NEXT_PUBLIC_SITE_URL=https://www.ipunto.digital

# Clave secreta de Stripe (modo test o live)
STRIPE_SECRET_KEY=sk_test_...

# Secreto del webhook de Stripe para verificar eventos
STRIPE_WEBHOOK_SECRET=whsec_...

# --- OPCIONALES (activan funcionalidades específicas) ---

# API Key de Brevo para envío de correos transaccionales
BREVO_API_KEY=

# Número de WhatsApp para botones de contacto (formato: 521XXXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Correo(s) del administrador separados por coma
ADMIN_EMAIL=

# Habilita las superficies privadas: /cliente, /admin, /onboarding
# Cambiar a "true" solo cuando la autenticación (ChatGPT Sign In) esté lista
PRIVATE_SURFACES_ENABLED=false

# --- SOLO DESARROLLO LOCAL ---

# Sandbox de Codex (no tocar, se setea automáticamente)
# CODEX_SANDBOX=seatbelt

# --- PROSPECT OS (adquisición asistida de clientes) ---
# Requiere también PRIVATE_SURFACES_ENABLED=true. Se desactiva siempre en Vercel,
# porque allí la identidad de la plataforma no está verificada.
PROSPECT_OS_ENABLED=false

# Credenciales de proveedores: solo como secretos del entorno, nunca NEXT_PUBLIC_*.
# Ninguna llamada con costo ocurre sin un presupuesto mensual habilitado en el panel.
GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
