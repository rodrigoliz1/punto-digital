# Copia este archivo como cloudflare/equipo.env (ignorado por git) y completa los valores
# que te muestre Cloudflare al crear los recursos. Aquí NO van secretos: solo nombres e IDs.
CF_WORKER_NAME=punto-digital-equipo
CF_D1_DATABASE_NAME=punto-digital-equipo
CF_D1_DATABASE_ID=
CF_R2_BUCKET_NAME=punto-digital-equipo-archivos
# Dirección pública del panel. Primera etapa: la de workers.dev; después, https://equipo.ipunto.digital
CF_TEAM_URL=
